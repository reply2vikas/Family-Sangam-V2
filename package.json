{
  "name": "family-sangam",
  "version": "2.0.0",
  "description": "One family budget for every celebration this season: weddings, birthdays and community events.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "node scripts/lint.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='shared/**' --test-coverage-include='server/**' --test-coverage-include='api/**' --test-coverage-include='client/ui/h.ts' --test-coverage-include='client/ui/state.ts' --test-coverage-include='client/ui/api.ts' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"test/*.test.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
